{
    "name": "Sad Panda",
    "description": "Access to ExHentai",
    "version": "3.4",
    "manifest_version": 3,
    "permissions": [
        "cookies",
        "declarativeNetRequestWithHostAccess",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "*://e-hentai.org/*",
        "*://*.e-hentai.org/*",
        "*://exhentai.org/*",
        "*://*.exhentai.org/*"
    ],
    "icons": {
        "16": "ico/16.png",
        "32": "ico/32.png",
        "48": "ico/48.png",
        "64": "ico/64.png",
        "128": "ico/128.png"
    },
    "background": {
        "service_worker": "js/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://exhentai.org/*"
            ],
            "js": [
                "js/jquery.min.js",
                "js/login.js",
                "js/logout.js"
            ],
            "css": [
                "css/logout.css"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "html/login.html",
                "css/bootstrap.min.css",
                "css/login.css",
                "ico/128.png",
                "img/GitHub-Mark-Light-64px.png"
            ],
            "matches": [
                "*://exhentai.org/*"
            ]
        }
    ]
}
